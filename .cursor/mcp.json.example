{
  "mcpServers": {
    "zora": {
      "command": "/Users/<your-username>/Downloads/TOE/.venv/bin/python",
      "args": [
        "-m",
        "mcp.cli",
        "run",
        "/Users/<your-username>/Downloads/TOE/mcp/zora_mcp_server.py"
      ],
      "disabled": true,
      "autoApprove": ["zora_health_check", "open_zora_discovery", "open_zora_dashboard", "zora_query", "zora_ask", "zora_dashboard_send", "zora_dashboard_status"]
    },
    "macos-use": {
      "command": "npx",
      "args": ["-y", "mcp-server-macos-use"],
      "disabled": true,
      "env": {}
    },
    "applescript": {
      "command": "npx",
      "args": ["-y", "applescript-mcp"],
      "disabled": true,
      "env": {}
    }
  }
}
